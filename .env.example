# Copy this file to ".env" and paste your key (get one at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_api_key_here

# Gemini model used for Q&A, quiz, summary and learning path.
# Change this if Google retires or renames a model (see https://ai.google.dev/gemini-api/docs/models).
GEMINI_MODEL=gemini-2.5-flash

# Local model used for concept explanations (downloaded once from Hugging Face, ~3 GB).
EXPLAIN_MODEL=MBZUAI/LaMini-Flan-T5-783M

# If true, /explain uses Gemini whenever the local model cannot load (low disk/RAM, no internet to Hugging Face).
EXPLAIN_FALLBACK_TO_GEMINI=true
